# =============================================================================
# Configurația backendului în Docker.
#
#   cp backend/.env.docker.example backend/.env.docker
#
# Apoi completează secțiunile marcate [OBLIGATORIU]. Cele marcate [OPȚIONAL] pot
# rămâne goale: funcționalitatea lor se oprește singură, restul platformei merge.
#
# Fișierul e citit de toate serviciile din compose.yaml (app, queue, scheduler,
# reverb, init, mysql, redis, phpmyadmin) — deci se editează într-un singur loc.
# =============================================================================

# --- Aplicație [OBLIGATORIU] -------------------------------------------------
APP_NAME=telemedconsult.md
APP_ENV=production
# Generează cheia o singură dată, înainte de primul `up`:
#   docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=base64:GENEREAZA_O_CHEIE_LARAVEL
APP_DEBUG=false
APP_URL=https://telemedconsult.md
FRONTEND_URL=https://telemedconsult.md
# Fusul folosit de sarcinile programate la oră fixă și de datele din panouri.
APP_TIMEZONE=Europe/Chisinau

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Baza de date [OBLIGATORIU] ----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=telemedconsult
DB_USERNAME=telemedconsult
DB_PASSWORD=SCHIMBA_CU_O_PAROLA_PUTERNICA

# Variabilele MYSQL_* inițializează containerul MySQL la prima pornire.
# MYSQL_DATABASE/USER/PASSWORD trebuie să corespundă cu DB_* de mai sus.
MYSQL_DATABASE=telemedconsult
MYSQL_USER=telemedconsult
MYSQL_PASSWORD=SCHIMBA_CU_O_PAROLA_PUTERNICA
MYSQL_ROOT_PASSWORD=SCHIMBA_CU_ALTA_PAROLA_PUTERNICA

# --- Redis, cozi, sesiuni [OBLIGATORIU] --------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SCHIMBA_CU_O_PAROLA_REDIS_PUTERNICA

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# --- Websocket (Reverb) [OBLIGATORIU] ----------------------------------------
# REVERB_APP_KEY trebuie să fie identic cu VITE_REVERB_APP_KEY din frontend.
REVERB_APP_ID=telemedconsult
REVERB_APP_KEY=SCHIMBA_CU_O_CHEIE_REVERB
REVERB_APP_SECRET=SCHIMBA_CU_UN_SECRET_REVERB
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Pornire / migrări -------------------------------------------------------
# true = rulează TOATE seederele la pornire (date demo). Pe producție: false.
RUN_SEEDERS=false
OTP_DEMO_CODE_ENABLED=false
OTP_EXPIRES_MINUTES=10

# --- Email [OBLIGATORIU: fără el nu se pot confirma conturile] ---------------
MAIL_MAILER=resend
RESEND_API_KEY=INTRODU_CHEIA_API_RESEND
MAIL_FROM_ADDRESS=no-reply@notify.telemedconsult.md
MAIL_FROM_NAME=telemedconsult.md

# --- Plăți MAIB [OPȚIONAL: gol = alimentările de portofel nu funcționează] ---
MAIB_PROJECT_ID=
MAIB_PROJECT_SECRET=
MAIB_SIGNATURE_KEY=
MAIB_OK_URL=https://telemedconsult.md/api/v1/payments/maib/ok
MAIB_CALLBACK_URL=https://telemedconsult.md/api/v1/payments/callback/maib
MAIB_FAIL_URL=https://telemedconsult.md/api/v1/payments/maib/fail

# =============================================================================
# HIGO — aparatul de examinare
# =============================================================================

# --- Contul cu care NOI îi apelăm pe EI [OPȚIONAL] ---------------------------
# Gol = integrarea se oprește singură: conturile nu pleacă spre HIGO, iar
# `higo:pull` din scheduler raportează „oprită” și nu face nimic.
HIGO_BASE_URL=https://backend.higo.health
HIGO_CLIENT_ID=
HIGO_CLIENT_SECRET=
HIGO_USERNAME=
HIGO_PASSWORD=
HIGO_OAUTH_TOKEN_PATH=/oauth/token
HIGO_CACHE_STORE=redis
HIGO_REQUIRE_SHARED_LOCK_STORE=true
# false oprește complet trimiterile spre HIGO, păstrând restul integrării.
HIGO_SYNC_ENABLED=true

# --- Recepția examinărilor ---------------------------------------------------
# Secretul din URL-ul webhook-ului. Generează: openssl rand -hex 24
# Gol = webhook-ul respinge orice apel; examinările vin doar prin `higo:pull`.
HIGO_EXAM_WEBHOOK_SECRET=

# Credențialele cu care HIGO ne apelează pe noi (Basic auth), separate de cele
# de mai sus. Se dau la abonare: openssl rand -hex 24
HIGO_NOTIFY_CLIENT_ID=
HIGO_NOTIFY_CLIENT_SECRET=

# Nivelul abonării: Encounter | DiagnosticReport | Media
HIGO_SUBSCRIPTION_CRITERIA=DiagnosticReport

# true = `init` înregistrează abonarea la fiecare pornire. Ține-l pe false:
# fiecare rulare creează o abonare NOUĂ la ei. Rulează manual, o dată, după ce
# domeniul e public și pe HTTPS:
#   docker compose exec app php artisan higo:subscribe
HIGO_SUBSCRIBE_ON_DEPLOY=false

# --- Imaginile și înregistrările examinării ----------------------------------
# Se descarcă la noi (url-urile lor expiră într-o oră) pe volumul `app-storage`.
HIGO_MEDIA_DISK=local
HIGO_MEDIA_TIMEOUT=30
# Cât timp e valabil linkul semnat din fișa consultației (minute).
HIGO_MEDIA_LINK_MINUTES=60

# =============================================================================
# Telegram — notificări către utilizatori
# =============================================================================
# [OPȚIONAL] Gol = butonul de conectare Telegram nu apare, restul merge.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret aleator folosit în URL-ul webhook-ului: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# true = `init` înregistrează webhook-ul la fiecare pornire (idempotent la ei).
# Pune-l pe false dacă domeniul încă nu e public — altfel Telegram refuză.
TELEGRAM_WEBHOOK_AUTO_SET=true

# =============================================================================
# phpMyAdmin (containerul de administrare a bazei)
# =============================================================================
PMA_HOST=mysql
PMA_PORT=3306
UPLOAD_LIMIT=64M
MEMORY_LIMIT=512M
MAX_EXECUTION_TIME=600
